<Application x:Class="WorkTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme brushes (Light/Dark) — swapped live by Services/Theme.cs (must stay index 0) -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <!-- Implicit control styles that follow the theme -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Load ramp (steps 0..10): green steps for normal days, switching to
                 cyan for high load (full cyan at 25+, deep cyan at 30+) so lows and
                 highs are clearly distinguishable -->
            <SolidColorBrush x:Key="Load0" Color="#E1E4E8"/>
            <SolidColorBrush x:Key="Load1" Color="#C9F2CC"/>
            <SolidColorBrush x:Key="Load2" Color="#9FE3A8"/>
            <SolidColorBrush x:Key="Load3" Color="#6FCF85"/>
            <SolidColorBrush x:Key="Load4" Color="#40C463"/>
            <SolidColorBrush x:Key="Load5" Color="#1FA34A"/>
            <SolidColorBrush x:Key="Load6" Color="#15803D"/>
            <SolidColorBrush x:Key="Load7" Color="#0F5A2E"/>
            <SolidColorBrush x:Key="Load8" Color="#147D54"/>
            <SolidColorBrush x:Key="Load9" Color="#00B8D4"/>
            <SolidColorBrush x:Key="Load10" Color="#00779B"/>

            <!-- Neutral hatch for cells with only unscored commits (colors follow the theme) -->
            <DrawingBrush x:Key="UnscoredBrush" TileMode="Tile"
                          Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{DynamicResource UnscoredBase}"><GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{DynamicResource UnscoredLines}"><GeometryDrawing.Geometry>
                            <PathGeometry Figures="M -2,10 L 10,-2 M 2,10 L 10,2"/></GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
