<Window x:Class="WorkTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkTracker" Height="900" Width="1400" Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}">
    <DockPanel Margin="0" Background="{DynamicResource WindowBackground}">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="6" Margin="0,0,0,8"
                Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="repo:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="RepoText" VerticalAlignment="Center" Margin="0,0,16,0"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="developer:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="DeveloperCombo" Width="180" VerticalAlignment="Center"
                              SelectionChanged="DeveloperCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0">
                        <MenuItem Header="Tools">
                            <MenuItem x:Name="RescoreDayMenu" Header="Re-score day"
                                      Click="RescoreDay_Click"/>
                            <MenuItem x:Name="RescoreDeveloperMenu" Header="Re-score developer"
                                      Click="RescoreDeveloper_Click"/>
                            <MenuItem x:Name="RescoreAllMenu" Header="Re-score all (window)"
                                      Click="RescoreAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Open data folder" Click="OpenDataFolder_Click"/>
                        </MenuItem>
                    </Menu>
                    <Button x:Name="SettingsButton" Content="Settings" Padding="10,3"
                            Click="Settings_Click"/>
                </StackPanel>
                <TextBlock x:Name="WindowText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Background="{DynamicResource ToolbarBackground}"
                   Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource PanelBorderBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Padding="12" Background="{DynamicResource WindowBackground}">
                <Grid x:Name="GridHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Column="2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBackground}">
                <ContentControl x:Name="DetailHost"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
